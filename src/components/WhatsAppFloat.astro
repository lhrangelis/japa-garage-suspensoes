---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<a
  class="wa-float"
  href={site.whatsapp}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar com a Japa Garage no WhatsApp"
>
  <Icon name="whatsapp" size={30} strokeWidth={1.9} />
</a>

<style>
  .wa-float {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 50;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--green);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    transition: background-color 0.15s ease;
  }
  .wa-float:hover {
    background: var(--green-dark);
    color: #fff;
  }
  @media (max-width: 600px) {
    .wa-float {
      right: 16px;
      bottom: 16px;
    }
  }
</style>
